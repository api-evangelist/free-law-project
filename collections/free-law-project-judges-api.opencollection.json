{
  "opencollection": "1.0.0",
  "info": {
    "name": "Free Law Project / CourtListener REST Alerts Judges API",
    "version": "4.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Judges",
        "type": "folder"
      },
      "items": [
        {
          "info": {

            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List judges and people"
        },
        {
          "info": {
            "name": "List judicial positions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.courtlistener.com/api/rest/v4/positions/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List judicial positions"
        }
      ]
    }
  ],
  "bundled": true
}
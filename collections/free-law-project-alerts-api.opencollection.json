{
  "opencollection": "1.0.0",
  "info": {
    "name": "Free Law Project / CourtListener REST Alerts API",
    "version": "4.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.courtlistener.com/api/rest/v4/alerts/"
          },
          "docs": "List alerts"
        },
        {
          "info": {
            "name": "Create an alert",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.courtlistener.com/api/rest/v4/alerts/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an alert"
        }
      ]
    }
  ],
  "bundled": true
}
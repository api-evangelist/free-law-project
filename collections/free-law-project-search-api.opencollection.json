{
  "opencollection": "1.0.0",
  "info": {
    "name": "Free Law Project / CourtListener REST Alerts Search API",
    "version": "4.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search across CourtListener",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.courtlistener.com/api/rest/v4/search/",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query string."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Result type (e.g., o for opinions, r for RECAP, oa for oral arguments, p for people)."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Full-text and faceted search across opinions, dockets, oral arguments, judges, and more."
        }
      ]
    }
  ],
  "bundled": true
}